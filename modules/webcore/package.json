{
  "name": "@metteur/webcore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:node",
    "typecheck:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen:proto": "node scripts/gen-protobuf.mjs",
    "test:e2e": "playwright test --project=e2e",
    "test:monkey": "playwright test --project=monkey",
    "test:live": "node scripts/run-live.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@lucide/vue": "^1.47.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "dompurify": "3.4.15",
    "markdown-it": "15.0.2",
    "monaco-editor": "^0.56.0",
    "ohash": "^2.0.12",
    "pinia": "^4.0.3",
    "shiki": "4.4.3",
    "smol-toml": "^1.8.0",
    "vue": "3.6.0-rc.9",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@playwright/browser-chromium": "^1.63.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
